#!/usr/bin/env bash
# DEPRECATED: unattended autodeploy для Converter больше не рекомендован СБ.
#
# Причина: старый вариант делал git reset --hard на FETCH_HEAD без ручного подтверждения.
# Используйте deploy/vps/manual-approved-deploy.sh.example: fetch -> verify commit ->
# approval marker -> backup -> docker compose --env-file deploy/vps/.env -f docker-compose.vps.yml up -d.

set -euo pipefail

echo "[converter-autodeploy] deprecated; use deploy/vps/manual-approved-deploy.sh.example"
exit 2
