# Шаблон для VPS (СБ): реальные значения хранятся только в deploy/vps/.env на сервере.
# Этот набор совпадает с текущей рабочей схемой converter.acom-offer-desk.ru (/auth, loopback-порты 180xx).

CONVERTER_FQDN=converter.acom-offer-desk.ru
CONVERTER_PUBLIC_ORIGIN=https://converter.acom-offer-desk.ru
CONVERTER_KEYCLOAK_ISSUER_PUBLIC=https://converter.acom-offer-desk.ru/auth/realms/uom
CONVERTER_ALLOWED_HOSTS=converter.acom-offer-desk.ru
# В docker-compose.vps.yml к этому значению дописываются nsi,documents,localhost,127.0.0.1 — для HTTP-проб
# мониторинга (dephealth/uniproxy): клиент Go шлёт Host из URL (имя сервиса в Docker).
OPENAPI_PUBLIC_ENABLED=0

# Converter Postgres only (not order_database): security branch expects TLS-by-default.
# Provision deploy/vps/postgres-tls before the first SB deploy.
CONVERTER_POSTGRES_TLS_ENABLED=on
KEYCLOAK_DB_PASSWORD=CHANGE_ME_KEYCLOAK_DB_PASSWORD
NSI_DB_PASSWORD=CHANGE_ME_NSI_DB_PASSWORD
DOCUMENTS_DB_PASSWORD=CHANGE_ME_DOCUMENTS_DB_PASSWORD
NSI_DATABASE_URL=postgres://nsi:CHANGE_ME_NSI_DB_PASSWORD@nsi_db:5432/nsi?sslmode=verify-full&sslrootcert=/etc/postgresql/tls/root.crt
DOCUMENTS_DATABASE_URL=postgres://documents:CHANGE_ME_DOCUMENTS_DB_PASSWORD@documents_db:5432/documents?sslmode=verify-full&sslrootcert=/etc/postgresql/tls/root.crt
KC_DB_TLS_MODE=verify-server
KC_DB_TLS_TRUST_STORE_FILE=/etc/postgresql/tls/root.crt

# СБ: при непустом значении сервисы проверяют claim aud в JWT.
# Оставить пустым до проверки фактических токенов Keycloak, чтобы не сломать текущий login flow.
# KEYCLOAK_JWT_AUDIENCE=account

S2S_CLIENT_SECRET=CHANGE_ME_S2S_SECRET

NSI_DJANGO_SECRET_KEY=CHANGE_ME_NSI_SECRET
DOCS_DJANGO_SECRET_KEY=CHANGE_ME_DOCS_SECRET

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT

# RabbitMQ (официальный образ): не использовать guest/guest. Пароль в URL должен быть безопасен для AMQP URI
# (без «сырых» :, @, / — иначе задайте полный CELERY_BROKER_URL вручную в секретном слое, не в Git).
RABBITMQ_DEFAULT_USER=converter_mq
RABBITMQ_DEFAULT_PASS=CHANGE_ME_RABBITMQ_PASS
CELERY_BROKER_SSL_CA_CERT=/etc/rabbitmq/tls/ca_certificate.pem
CELERY_BROKER_SSL_CERTFILE=/etc/rabbitmq/tls/client_certificate.pem
CELERY_BROKER_SSL_KEYFILE=/etc/rabbitmq/tls/client_key.pem
#
# Если volume RabbitMQ уже создан со старыми дефолтами, переменные выше действуют только при первом init.
# Тогда: завести отдельного пользователя через rabbitmqctl внутри контейнера или планово пересоздать volume
# после бэкапа очередей — согласовать с ИБ.

# MinIO: documents/documents_worker должны проверять внутренний TLS-сертификат.
MINIO_CA_CERT_PATH=/etc/minio/certs/CAs/public.crt

# Пароль первичного пользователя seed. После первичного входа сменить и включить 2FA.
SEED_PASSWORD=CHANGE_ME_OPERATOR_PASSWORD
